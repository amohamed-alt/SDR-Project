{
  "version": 2,
  "updatedAt": "2026-09-02",
  "purpose": "Curated reference stack for SDR work. References are not installed or production-approved by default.",
  "policy": {
    "localProjectWins": true,
    "officialUpstreamBeforeCommunity": true,
    "doNotInstallByDefault": true,
    "verifyHealthBeforeUse": true,
    "preserveHubSpotAsSystemOfRecord": true,
    "productionColdEmailSender": null,
    "doNotReintroduceRetiredOutreachVendors": true,
    "readRelevantOnly": true
  },
  "defaults": {
    "orchestration": "n8n",
    "webExtraction": "Firecrawl",
    "interactiveBrowserAgent": "Browser Use",
    "deterministicBrowserAutomation": "Microsoft Playwright",
    "emailPreverificationReference": "Reacher",
    "paidEmailVerification": "MillionVerifier",
    "uiFrameworkReference": "Vercel / Next.js"
  },
  "sources": [
    {
      "name": "n8n",
      "repo": "https://github.com/n8n-io/n8n",
      "status": "preferred-existing-system",
      "useFor": ["workflow-automation", "orchestration", "webhooks", "scheduled-jobs"]
    },
    {
      "name": "Firecrawl",
      "repo": "https://github.com/firecrawl/firecrawl",
      "status": "preferred-web-extraction-reference",
      "useFor": ["crawl", "scrape", "structured-extraction", "career-pages", "company-websites"]
    },
    {
      "name": "Microsoft Playwright",
      "repo": "https://github.com/microsoft/playwright",
      "status": "preferred-deterministic-browser-reference",
      "useFor": ["browser-automation", "testing", "dynamic-sites"]
    },
    {
      "name": "Browser Use",
      "repo": "https://github.com/browser-use/browser-use",
      "status": "optional-agentic-browser-reference",
      "useFor": ["interactive-research", "agentic-navigation"]
    },
    {
      "name": "SearXNG",
      "repo": "https://github.com/searxng/searxng",
      "status": "external-reference-only",
      "useFor": ["metasearch", "research-discovery"],
      "notes": "No SearXNG deployment is owned by SDR-Project. Verify a separately managed instance before use."
    },
    {
      "name": "Reacher",
      "repo": "https://github.com/reacherhq/check-if-email-exists",
      "status": "optional-email-preverification-reference",
      "useFor": ["email-verification", "syntax", "mx", "smtp", "catch-all"]
    },
    {
      "name": "OpenAI Cookbook",
      "repo": "https://github.com/openai/openai-cookbook",
      "status": "preferred-openai-reference",
      "useFor": ["agents", "tool-calling", "structured-outputs", "evals", "rag"]
    },
    {
      "name": "LiteLLM",
      "repo": "https://github.com/BerriAI/litellm",
      "status": "optional-specialist",
      "useFor": ["multi-provider-llm", "model-routing", "quotas"]
    },
    {
      "name": "Langfuse",
      "repo": "https://github.com/langfuse/langfuse",
      "status": "optional-specialist",
      "useFor": ["llm-tracing", "evaluations", "cost-tracking"]
    },
    {
      "name": "Windmill",
      "repo": "https://github.com/windmill-labs/windmill",
      "status": "optional-specialist",
      "useFor": ["internal-tools", "scripts-as-jobs"]
    },
    {
      "name": "NocoDB",
      "repo": "https://github.com/nocodb/nocodb",
      "status": "optional-specialist",
      "useFor": ["internal-data-ui", "manual-review-queues"]
    },
    {
      "name": "Listmonk",
      "repo": "https://github.com/knadh/listmonk",
      "status": "reference-only",
      "useFor": ["email-campaign-architecture"]
    },
    {
      "name": "Mautic",
      "repo": "https://github.com/mautic/mautic",
      "status": "reference-only",
      "useFor": ["marketing-automation", "segmentation"]
    },
    {
      "name": "Quickly",
      "repo": "https://github.com/AbdelftahZowail/Quickly",
      "status": "experimental-reference-only",
      "useFor": ["cold-email-architecture", "multi-inbox", "sequences"]
    }
  ]
}
