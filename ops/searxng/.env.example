# Bind the research service to loopback by default.
SEARXNG_HOST_PORT=8088

# If you later publish the service behind a trusted reverse proxy, replace
# this with the exact external URL including the trailing slash.
SEARXNG_BASE_URL=http://127.0.0.1:8088/

# Generate a unique value before first start, for example:
#   openssl rand -hex 32
SEARXNG_SECRET=replace-me-with-a-random-secret
