{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Talentera SDR Ultimate Dashboard",
    "purpose": "Figma-ready source tokens for the experimental premium dashboard view",
    "source": "src/app/tailwind.css"
  },
  "color": {
    "brand": {
      "950": { "$value": "#071c17", "$type": "color" },
      "900": { "$value": "#0a2a22", "$type": "color" },
      "800": { "$value": "#0d4537", "$type": "color" },
      "700": { "$value": "#0f6a50", "$type": "color" },
      "600": { "$value": "#0b8a61", "$type": "color" },
      "500": { "$value": "#19b579", "$type": "color" },
      "400": { "$value": "#4bd59a", "$type": "color" },
      "300": { "$value": "#8be8bc", "$type": "color" },
      "200": { "$value": "#c4f3dc", "$type": "color" },
      "100": { "$value": "#e8faf1", "$type": "color" },
      "50": { "$value": "#f5fdf9", "$type": "color" }
    },
    "accent": {
      "blue": { "$value": "#4f8cff", "$type": "color" },
      "violet": { "$value": "#8b6cff", "$type": "color" },
      "amber": { "$value": "#f4b740", "$type": "color" },
      "rose": { "$value": "#ef6b78", "$type": "color" }
    }
  },
  "radius": {
    "sm": { "$value": "10px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "30px", "$type": "dimension" }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "160ms", "$type": "duration" },
    "normal": { "$value": "240ms", "$type": "duration" },
    "hero": { "$value": "520ms", "$type": "duration" }
  }
}
