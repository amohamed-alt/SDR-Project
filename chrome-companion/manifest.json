{
  "manifest_version": 3,
  "name": "Talentera Prospecting Companion",
  "version": "1.8.1",
  "description": "Capture 25, 50 or a full Sales Navigator search in the extension, then continue with HubSpot checks, reveals and CRM tasks in the dashboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://sdr.dashboardtalentera.tech/*"
  ],
  "background": {
    "service_worker": "background-v154.js"
  },
  "action": {
    "default_title": "Talentera Prospecting Companion",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://www.linkedin.com/sales/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sdr.dashboardtalentera.tech/signalhire-queue*",
        "https://sdr.dashboardtalentera.tech/salesnav-full-run*",
        "https://sdr.dashboardtalentera.tech/salesnav-prospecting*"
      ],
      "js": [
        "dashboard-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
