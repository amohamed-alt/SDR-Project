# Server-only HubSpot private app token. Never expose this as NEXT_PUBLIC_*.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=145742477
HUBSPOT_UI_DOMAIN=app-eu1.hubspot.com
HUBSPOT_TIMEZONE=Asia/Riyadh

# Dashboard defaults
DEFAULT_SDR_OWNER_ID=31644369
NEXT_PUBLIC_DEFAULT_START_DATE=2026-07-01
DASHBOARD_USERNAME=talentera
DASHBOARD_PASSWORD=
SDR_ADMIN_PASSWORD=
# Set true only when an upstream access gateway protects the whole deployment.
DISABLE_AUTH=false
DASHBOARD_CACHE_API_URL=http://dashboard-cache-api:8000
DASHBOARD_CACHE_READ_TIMEOUT_MS=700
DASHBOARD_CACHE_WRITE_TIMEOUT_MS=2000

# Net-new acquisition and controlled enrichment. Keep vendor keys server-only.
APOLLO_API_KEY=
SIGNALHIRE_API_KEY=
MILLIONVERIFIER_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
ACQUISITION_OWNER_TOKEN=
ACQUISITION_OWNER_IDS=31644369,76369997,31558980,76370000,76369995,76369998
ACQUISITION_OWNER_WEIGHTS=
MARITA_OWNER_ID=


# Google Calendar OAuth for the SDR workspace. Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sdr.dashboardtalentera.tech/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MARITA_GOOGLE_EMAIL=m.chedid@talentera.com
ABDULLAH_GOOGLE_EMAIL=a.mohamed@talentera.com
GOOGLE_TOKEN_STORE_PATH=/app/data/google-calendar.json

# Maqsam call ingest and internal sync.
MAQSAM_INGEST_SECRET=
MAQSAM_BASIC_AUTH=
MAQSAM_ACCESS_KEY=
MAQSAM_ACCESS_SECRET=
MAQSAM_TARGET_AGENT_EMAIL=m.chedid@bayt.net
# Verified HubSpot identity; override only if his Maqsam login differs.
MAQSAM_DANIEL_AGENT_EMAIL=d.beaini@bayt.net
MAQSAM_BACKFILL_FROM=2026-09-07
MAQSAM_SYNC_CHECKPOINT_PATH=/app/data/maqsam-sync-checkpoint.json
MAQSAM_SYNC_INTERVAL_SECONDS=600
MAQSAM_SYNC_LOOKBACK_SECONDS=10800
MAQSAM_SYNC_PAGE_COUNT=12
MAQSAM_CALL_STORE_PATH=/app/data/maqsam-calls.json
MAQSAM_CALL_RETENTION_DAYS=180
MAQSAM_CALL_MAX_RECORDS=50000

# Safe synthetic data for local UI development and CI.
DEMO_MODE=true

# Saudi task copy through Command Code; choose a chat/completions-capable model
COMMANDCODE_API=
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
COMMANDCODE_DAILY_LIMIT=200
COMMANDCODE_STATE_PATH=/app/data/commandcode-outreach.json
# Shared CommandCode gateway. Deep mode stays on the same model unless explicitly overridden.
COMMANDCODE_DEEP_MODEL=
COMMANDCODE_FAST_DAILY_LIMIT=150
COMMANDCODE_DEEP_DAILY_LIMIT=10
COMMANDCODE_FAST_MAX_OUTPUT_TOKENS=900
COMMANDCODE_DEEP_MAX_OUTPUT_TOKENS=1200
COMMANDCODE_MAX_INPUT_CHARS=12000
COMMANDCODE_CACHE_TTL_SECONDS=604800
COMMANDCODE_GATEWAY_STATE_PATH=/app/data/commandcode-gateway-state.json
