# Server-only HubSpot private app token. Never expose this as NEXT_PUBLIC_*.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=145742477
HUBSPOT_UI_DOMAIN=app-eu1.hubspot.com
HUBSPOT_TIMEZONE=Asia/Riyadh

# Dashboard defaults
DEFAULT_SDR_OWNER_ID=31644369
NEXT_PUBLIC_DEFAULT_START_DATE=2026-07-01
# Production dashboard access. When DASHBOARD_PASSWORD is empty, the existing
# ACQUISITION_OWNER_TOKEN is used as a migration-safe password.
DASHBOARD_USERNAME=talentera
DASHBOARD_PASSWORD=
# Set true only when an upstream access gateway protects the whole deployment.
DISABLE_AUTH=false
# Persistent FastAPI snapshot cache. Docker Compose sets the internal URL automatically in production.
DASHBOARD_CACHE_API_URL=http://dashboard-cache-api:8000
DASHBOARD_CACHE_READ_TIMEOUT_MS=700
DASHBOARD_CACHE_WRITE_TIMEOUT_MS=2000
# Comma-separated owner IDs to keep hot. Defaults to DEFAULT_SDR_OWNER_ID when empty.
DASHBOARD_WARM_OWNER_IDS=31644369
DASHBOARD_WARM_INTERVAL_SECONDS=300
# First-time authenticated visitors enter a display name for usage tracking.
# Usage analytics are stored in the private PostgreSQL service defined in docker-compose.yml.

# Net-New Account Acquisition. Both values are server-only.
# Apollo Organization Search costs 1 Apollo credit per results page (up to 100 companies/page).
APOLLO_API_KEY=
# Public users can view the queue, but SignalHire enrichment and HubSpot writes require this Owner key.
# Use a long random value and keep it only in the repository secret / your browser session.
ACQUISITION_OWNER_TOKEN=
# Optional routing overrides. Defaults are Marita, Ursula, Zein, Jehad, Faizan and Fadi.
ACQUISITION_OWNER_IDS=31644369,76369997,31558980,76370000,76369995,76369998
# Optional workload weights as ownerId:weight. Higher weight means that owner can absorb more open tasks.
ACQUISITION_OWNER_WEIGHTS=

# Cost-controlled OpenRouter gateway. Keep the key server-only.
# Nano is the normal path; Mini is explicit deep mode only. No automatic premium fallback.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=openai/gpt-4.1-nano
OPENROUTER_DEEP_MODEL=openai/gpt-4.1-mini
OPENROUTER_FAST_DAILY_LIMIT=150
OPENROUTER_DEEP_DAILY_LIMIT=10
OPENROUTER_FAST_MAX_OUTPUT_TOKENS=220
OPENROUTER_DEEP_MAX_OUTPUT_TOKENS=360
OPENROUTER_MAX_INPUT_CHARS=12000
OPENROUTER_CACHE_TTL_SECONDS=604800
OPENROUTER_CACHE_MAX_ENTRIES=500
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_STATE_PATH=/app/data/openrouter-cost-state.json

# Prospecting Cockpit. Keep all vendor keys server-only.
# SignalHire Search finds personas first; Person API credits are spent only when a selected person is enriched.
SIGNALHIRE_API_KEY=
# Tavily is a fallback only when the direct Career V3 pass cannot resolve a verified career destination.
# Runtime uses basic search (1 credit) and then live-verifies returned domains/pages before accepting them.
TAVILY_API_KEY=
# Optional explicit owner override for Push to Marita; defaults to DEFAULT_SDR_OWNER_ID.
MARITA_OWNER_ID=

# Smartlead Outreach Command Center. The API key is server-only and must be a GitHub Actions secret in production.
SMARTLEAD_API_KEY=
# Leave CAMPAIGN_ID empty to resolve the campaign by name. Bootstrap creates it as DRAFTED and never starts it automatically.
SMARTLEAD_CAMPAIGN_ID=
SMARTLEAD_CAMPAIGN_NAME=Talentera | Marita SDR | Localized 3-Touch
# Conservative new-lead cap. With three touches this keeps steady-state load reasonable across warmed inboxes.
SMARTLEAD_DAILY_NEW_LEADS=50
# Any Sales email, meeting, or communication inside this window protects the whole company from SDR email outreach.
SMARTLEAD_SALES_ACTIVITY_LOOKBACK_DAYS=45
SMARTLEAD_START_HOUR=09:30
SMARTLEAD_END_HOUR=16:30
SMARTLEAD_MIN_TIME_BETWEEN_EMAILS=15
MILLIONVERIFIER_API_KEY=
SIGNALHIRE_API_KEY=
# Fail closed. Enable only after the 15-inbox/domain, DNS, warmup, verification, and reputation checklist passes.
SMARTLEAD_AUTOPILOT_ENABLED=false
# Legacy paths do not include the full current safety gate and must remain disabled.
SMARTLEAD_LEGACY_SEND_ENABLED=false
SMARTLEAD_PREPARED_PATH=/app/data/smartlead-prepared.json

# Google Calendar OAuth for Marita Workspace. Server-only; never commit live values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sdr.dashboardtalentera.tech/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MARITA_GOOGLE_EMAIL=m.chedid@talentera.com
ABDULLAH_GOOGLE_EMAIL=a.mohamed@talentera.com
GOOGLE_TOKEN_STORE_PATH=/app/data/google-calendar.json

# Maqsam call ingest. Use the same strong random value in the n8n HTTP request header.
MAQSAM_INGEST_SECRET=
MAQSAM_CALL_STORE_PATH=/app/data/maqsam-calls.json
MAQSAM_CALL_RETENTION_DAYS=180
MAQSAM_CALL_MAX_RECORDS=5000

# Hiring Intelligence. The Docker sidecar runs rolling KSA/UAE batches so the full portfolio is refreshed within roughly 6 hours.
HIRING_SNAPSHOT_PATH=/app/data/hiring-signals.json
HIRING_SCAN_LIMIT=160
HIRING_SCAN_CONCURRENCY=10

# Career + ATS Intelligence V3.
# Primary discovery is fully self-hosted: direct website crawling + Playwright + deterministic ATS fingerprints + local Ollama judge.
# Prospecting may use Tavily only as a bounded search fallback when the self-hosted pass is inconclusive; Tavily results are never trusted without live verification.
# The portfolio includes companies where career_page_url is missing OR detected_ats is missing.
CAREER_INTELLIGENCE_STORE_PATH=/app/data/career-intelligence-v3.json
CAREER_ENGINE_URL=http://gtm-career-browser:3000/intelligence-detect
CAREER_ENGINE_TIMEOUT_MS=180000
CAREER_SCAN_LIMIT=30
CAREER_SCAN_CONCURRENCY=6
CAREER_PORTFOLIO_CACHE_MS=30000
# When true, only high-confidence verified results are written automatically, and existing HubSpot values are never overwritten.
CAREER_AUTO_PUSH=true
# Autonomous scanning starts only after the bounded V3 validation succeeds.
CAREER_AUTO_SCAN_ENABLED=true
# Existing V2 interval variable names remain supported by the sidecar for production compatibility.
CAREER_V2_SCAN_INTERVAL_SECONDS=60
CAREER_V2_IDLE_SECONDS=3600
CAREER_V2_ERROR_INTERVAL_SECONDS=300
CAREER_V2_MAX_ERROR_INTERVAL_SECONDS=1800

# Local Career AI Judge. KVM 8 has enough RAM for the stronger 8B model.
# The LLM is only a verifier/critic; discovery and ATS detection remain deterministic and free.
AI_JUDGE_ENABLED=true
OLLAMA_URL=http://career-judge-ollama:11434/api/chat
OLLAMA_MODEL=qwen3:8b
AI_JUDGE_TIMEOUT_MS=90000
AI_JUDGE_AUDIT_PERCENT=5
AI_JUDGE_MIN_RULE_SCORE=92

# Safe synthetic data for local UI development and CI.
DEMO_MODE=true
