# Server-only HubSpot private app token. Never expose this as NEXT_PUBLIC_*.
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=145742477
HUBSPOT_UI_DOMAIN=app-eu1.hubspot.com
HUBSPOT_TIMEZONE=Asia/Riyadh

# Dashboard defaults
DEFAULT_SDR_OWNER_ID=31644369
NEXT_PUBLIC_DEFAULT_START_DATE=2026-07-01
# The SDR dashboard is intentionally open; there is no Basic Auth layer.

# Google Calendar OAuth for Marita Workspace. Server-only; never commit live values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sdr.dashboardtalentera.tech/api/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MARITA_GOOGLE_EMAIL=m.chedid@talentera.com
ABDULLAH_GOOGLE_EMAIL=a.mohamed@talentera.com
GOOGLE_TOKEN_STORE_PATH=/app/data/google-calendar.json

# Maqsam call ingest. Use the same strong random value in the n8n HTTP request header.
MAQSAM_INGEST_SECRET=
MAQSAM_CALL_STORE_PATH=/app/data/maqsam-calls.json
MAQSAM_CALL_RETENTION_DAYS=180
MAQSAM_CALL_MAX_RECORDS=5000

# Hiring Intelligence. The Docker sidecar runs rolling KSA/UAE batches so the full portfolio is refreshed within roughly 6 hours.
HIRING_SNAPSHOT_PATH=/app/data/hiring-signals.json
HIRING_SCAN_LIMIT=160
HIRING_SCAN_CONCURRENCY=10

# Career Intelligence V2. Production Compose pins the V2 store/cache paths so the
# fresh backfill does not reuse V1 results. Old files remain preserved for audit.
CAREER_INTELLIGENCE_STORE_PATH=/app/data/career-intelligence-v2.json
CAREER_ENGINE_URL=http://gtm-career-browser:3000/career-detect
CAREER_ENGINE_TIMEOUT_MS=150000
CAREER_SCAN_LIMIT=20
CAREER_SCAN_CONCURRENCY=4
CAREER_PORTFOLIO_CACHE_MS=30000
# Autonomous scanning starts only after the bounded V2 validation succeeds.
CAREER_AUTO_SCAN_ENABLED=true
CAREER_V2_SCAN_LIMIT=20
CAREER_V2_SCAN_INTERVAL_SECONDS=60
CAREER_V2_IDLE_SECONDS=3600
CAREER_V2_ERROR_INTERVAL_SECONDS=300
CAREER_V2_MAX_ERROR_INTERVAL_SECONDS=1800

# Local Career AI Judge + low-cost GTM stages. Production Compose runs a private
# Ollama service on the internal Docker network; no API key is required.
AI_JUDGE_ENABLED=true
OLLAMA_URL=http://career-judge-ollama:11434/api/chat
OLLAMA_MODEL=qwen3:1.7b
AI_JUDGE_TIMEOUT_MS=45000
AI_JUDGE_AUDIT_PERCENT=10
AI_JUDGE_MIN_RULE_SCORE=90

# GTM Research hybrid AI routing. OpenRouter is used ONLY for TAM, ICP and Personas.
# Company research, sourcing, filters, copy and outreach-channel stages stay on local Ollama.
# GPT-4.1 Mini is intentionally the default premium model: much cheaper/faster than Sonnet
# while still supporting the structured JSON output this workflow needs.
# The app also caches identical premium-stage requests for 24h and caps paid requests/hour.
GTM_RESEARCH_OPENROUTER_API_KEY=
GTM_RESEARCH_OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional aliases supported by the code:
# OPENROUTER_API_KEY=
# GTM_RESEARCH_OLLAMA_URL=http://career-judge-ollama:11434/api/chat
# GTM_RESEARCH_OLLAMA_MODEL=qwen3:1.7b

# Safe synthetic data for local UI development and CI.
DEMO_MODE=true
